/* HERTEMUS Live Studio — Tema Roxo (variante do Yami oficial).
 * Compatibilidade: OBS Studio 30.2+; sem alterações no motor de transmissão.
 * Os três temas compartilham a mesma organização visual e variam na paleta.
 * Licenciamento: arquivos deste fork sob os termos do projeto OBS.
 */
@OBSThemeMeta {
    name: 'HERTEMUS | Roxo';
    id: 'br.com.hertemus.Yami.Roxo';
    extends: 'com.obsproject.Yami';
    author: 'HERTEMUS';
    dark: 'true';
}

@OBSThemeVars {
    /* Identidade visual */
    --primary: #854BFA;
    --primary_light: #A778FF;
    --primary_lighter: #C9ABFF;
    --primary_dark: #6030C8;
    --primary_darker: #39206F;

    /* Superficies: fundo / paineis / controles */
    --grey1: #3C2D56;
    --grey2: #322540;
    --grey3: #241B34;
    --grey4: #322540;
    --grey5: #241B34;
    --grey6: #1D162A;
    --grey7: #171121;
    --grey8: #0E0B15;
    --bg_window: #171121;
    --bg_base: #1D162A;
    --bg_preview: #0E0B15;
    --border_color: #3C2D56;

    /* Hierarquia e leitura */
    --text: #F7F5FC;
    --text_light: #FFFFFF;
    --text_muted: #AE9FC7;

    /* Inputs e selecao */
    --input_bg: #241B34;
    --input_bg_hover: #322540;
    --input_bg_focus: #1D162A;
    --input_border: #3C2D56;
    --input_border_hover: #A778FF;
    --input_border_focus: #854BFA;
    --list_item_bg_selected: #432574;
    --list_item_bg_hover: #432D69;

    /* Botoes / tabs / rolagem */
    --button_bg: #241B34;
    --button_bg_hover: #432D69;
    --button_bg_down: #432574;
    --button_border: #3C2D56;
    --button_border_hover: #A778FF;
    --button_border_focus: #854BFA;
    --tab_bg: #241B34;
    --tab_bg_hover: #432D69;
    --tab_bg_down: #432574;
    --tab_border: #3C2D56;
    --tab_border_hover: #A778FF;
    --tab_border_selected: #854BFA;
    --scrollbar_handle: #3C2D56;
    --scrollbar_hover: #854BFA;
    --scrollbar_down: #6030C8;
    --scrollbar_border: #1D162A;
    --toolbutton_bg: #241B34;
    --toolbutton_bg_hover: #432D69;
    --toolbutton_bg_down: #432574;

    /* Controles mais confortaveis, sem copiar o tema-base Yami */
    --border_radius: 6px;
    --border_radius_small: 4px;
    --border_radius_large: 9px;
    --highlight_color: #A778FF;
}

/* Paineis OBS: separacao visual discreta e titulo legivel. */
QDockWidget::title {
    background-color: #241B34;
    color: #F7F5FC;
    border-bottom: 1px solid #3C2D56;
    padding: 8px 10px;
    text-align: left;
}
QDockWidget > QWidget {
    background-color: #1D162A;
}
QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #432D69;
}
QTabBar::tab:selected {
    border-bottom: 2px solid #854BFA;
}
QMenu::separator {
    background-color: #3C2D56;
}
QMenu::item:selected,
QListWidget::item:selected,
SceneTree::item:selected,
SourceTree::item:selected {
    background-color: #432574;
    color: #FFFFFF;
}
QMenu::item:hover,
QListWidget::item:hover,
SceneTree::item:hover,
SourceTree::item:hover {
    background-color: #432D69;
}
/* Estado de foco reconhecivel sem tirar a indicacao de live/gravacao. */
QLineEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #854BFA;
}
QToolButton:hover {
    border-color: #A778FF;
}
QScrollBar::handle:hover {
    background-color: #854BFA;
}
